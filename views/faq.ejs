<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>

<%- include('partials/navbar') %>

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="hero-bg"></div>
    <div class="container page-hero-inner">
      <span class="badge"><i class="fa-solid fa-circle-question"></i> Frequently Asked</span>
      <h1>Technical Questions, <span class="highlight">Straight Answers</span></h1>
      <p>The stuff decision-makers actually ask before hiring one person for both development and tracking — grouped by topic so you can jump to what matters.</p>
      <nav class="breadcrumb">
        <a href="/">Home</a> <i class="fa-solid fa-chevron-right"></i> <span>FAQ</span>
      </nav>
    </div>
  </section>

  <!-- ===== FAQ GROUPS ===== -->
  <!-- Questions/answers loaded from the database (db/schema.sql + db/seed.sql, -->
  <!-- via models/faq.js). Category badge/heading/subtitle are presentational -->
  <!-- and live in models/faq.js's CATEGORY_META. -->
<% faqGroups.forEach(function(group, i) { %>
  <section class="section<%= i % 2 === 1 ? ' bg-soft' : '' %>">
    <div class="container">
      <div class="section-head">
        <span class="badge"><%= group.badge %></span>
        <h2><%- group.heading %></h2>
        <p><%= group.subtitle %></p>
      </div>
      <div class="faq-wrap">
<% group.items.forEach(function(item) { %>
        <div class="faq-item">
          <button class="faq-q"><%= item.question %> <i class="fa-solid fa-plus"></i></button>
          <div class="faq-a"><p><%- item.answer %></p></div>
        </div>
<% }); %>
      </div>
    </div>
  </section>
<% }); %>

  <!-- ===== MINI CTA ===== -->
  <section class="section mini-cta">
    <div class="container">
      <span class="badge"><i class="fa-solid fa-comments"></i> Still Curious?</span>
      <h2>Didn't See Your Question?</h2>
      <p>Message me on WhatsApp with whatever you're wondering — I'll give you a straight answer, no sales pitch.</p>
      <a href="/contact.html" class="btn btn-primary">Ask Me Directly <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </section>

<%- include('partials/footer') %>
<%- include('partials/whatsapp-float', { waText }) %>
</body>
</html>
