<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
</head>
<body class="admin-body">
  <div class="admin-shell">
<%- include('../partials/nav') %>
    <main class="admin-main">
      <h1>Edit Track — <%- item.letter %></h1>
      <p class="subtitle">Anchor controls the services.html#anchor jump target for "See the detail".</p>

<% if (typeof error !== 'undefined' && error) { %>
      <div class="admin-error"><%= error %></div>
<% } %>

      <form class="admin-form admin-card" method="POST" action="/admin/tracks/<%= item.id %>">
        <div class="form-row-2">
          <div class="field">
            <label for="letter">Letter label (e.g. "Track A")</label>
            <input type="text" id="letter" name="letter" value="<%= item.letter %>" required />
          </div>
          <div class="field">
            <label for="icon">Icon (Font Awesome class)</label>
            <input type="text" id="icon" name="icon" value="<%= item.icon %>" required />
          </div>
        </div>

        <div class="form-row-2">
          <div class="field">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" value="<%= item.title %>" required />
          </div>
          <div class="field">
            <label for="anchor">Anchor (e.g. "dev")</label>
            <input type="text" id="anchor" name="anchor" value="<%= item.anchor %>" required />
          </div>
        </div>

        <div class="field">
          <label for="summary">Summary</label>
          <textarea id="summary" name="summary" rows="3" required><%= item.summary %></textarea>
        </div>
        <div class="field">
          <label for="owner_note">Owner note (homepage card)</label>
          <input type="text" id="owner_note" name="owner_note" value="<%= item.owner_note %>" required />
          <p class="hint">e.g. "Led by me, dev specialist on the build"</p>
        </div>
        <div class="field">
          <label for="features">Features (one per line)</label>
          <textarea id="features" name="features" rows="4"><%= item.features.join('\n') %></textarea>
        </div>

        <div class="form-row-2">
          <div class="field">
            <label for="sort_order">Display order</label>
            <input type="number" id="sort_order" name="sort_order" value="<%= item.sort_order %>" />
          </div>
          <div class="field">
            <label>&nbsp;</label>
            <div class="checkbox-row">
              <input type="checkbox" id="is_published" name="is_published" <%= item.is_published ? 'checked' : '' %> />
              <label for="is_published" style="margin:0;">Published (visible on the site)</label>
            </div>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="admin-btn admin-btn-primary">Save Changes</button>
          <a href="/admin/tracks" class="admin-btn admin-btn-outline">Cancel</a>
        </div>
      </form>
    </main>
  </div>
</body>
</html>
