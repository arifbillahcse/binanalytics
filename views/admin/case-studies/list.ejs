<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
</head>
<body class="admin-body">
  <div class="admin-shell">
<%- include('../partials/nav') %>
    <main class="admin-main">
      <div class="admin-toolbar">
        <div>
          <h1 style="margin-bottom:4px;">Case Studies</h1>
          <p class="subtitle" style="margin-bottom:0;">Problem → Diagnosis → Fix → Result entries shown on the homepage and /case-studies.html.</p>
        </div>
        <a href="/admin/case-studies/new" class="admin-btn admin-btn-primary"><i class="fa-solid fa-plus"></i> New Case Study</a>
      </div>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Tag</th>
            <th>Status</th>
            <th>Order</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
<% if (cases.length === 0) { %>
          <tr><td colspan="5" style="color:var(--a-text-light);">No case studies yet.</td></tr>
<% } %>
<% cases.forEach(function(c) { %>
          <tr>
            <td><%= c.title %><% if (c.is_placeholder) { %> <span class="badge-pill badge-draft">placeholder</span><% } %></td>
            <td><%= c.tag %></td>
            <td><span class="badge-pill <%= c.is_published ? 'badge-published' : 'badge-draft' %>"><%= c.is_published ? 'Published' : 'Hidden' %></span></td>
            <td><%= c.sort_order %></td>
            <td class="actions">
              <a href="/admin/case-studies/<%= c.id %>/edit" class="admin-btn admin-btn-outline admin-btn-sm">Edit</a>
              <form method="POST" action="/admin/case-studies/<%= c.id %>/delete" onsubmit="return confirm('Delete this case study? This cannot be undone.');" style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">Delete</button>
              </form>
            </td>
          </tr>
<% }); %>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>
