<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>

<%- include('partials/navbar') %>

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <div class="hero-bg"></div>
    <div class="container page-hero-inner">
      <span class="badge"><i class="fa-solid fa-folder-open"></i> Selected Work</span>
      <h1>Real Problems, <span class="highlight">Diagnosed &amp; Fixed</span></h1>
      <p>No vanity screenshots. Every case follows the same honest format — the problem, how I diagnosed it, what I did, and the measurable result.</p>
      <nav class="breadcrumb">
        <a href="/">Home</a> <i class="fa-solid fa-chevron-right"></i> <span>Case Studies</span>
      </nav>
    </div>
  </section>

  <!-- ===== RESULTS STRIP ===== -->
  <section class="results">
    <div class="container">
      <div class="results-head">
        <h2>Numbers From Recent Work</h2>
        <p>The kind of measurable change good tracking and clean builds actually produce.</p>
      </div>
      <div class="results-grid">
        <div class="result-item">
          <strong data-count="38">0</strong><span class="suffix">%</span>
          <p>Duplicate purchase events eliminated</p>
        </div>
        <div class="result-item">
          <strong data-count="100">0</strong><span class="suffix">%</span>
          <p>Of phone leads now attributed to ads</p>
        </div>
        <div class="result-item">
          <strong data-count="9.2" data-decimal="1">0</strong><span class="suffix"> EMQ</span>
          <p>Meta Event Match Quality reached</p>
        </div>
        <div class="result-item">
          <strong data-count="700">0</strong><span class="suffix">k+</span>
          <p>Monthly visitors tracked accurately</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CASE STUDIES ===== -->
  <!-- Case-study content is loaded from the database (db/schema.sql + db/seed.sql, -->
  <!-- via models/caseStudies.js). Seeded figures are flagged is_placeholder=1 until -->
  <!-- replaced with real client numbers. -->
  <section class="cases section">
    <div class="container">
      <div class="section-head">
        <span class="badge">The Details</span>
        <h2>Three Problems, <span class="highlight">Three Clean Fixes</span></h2>
        <p>Consistency beats creativity here — the same Problem → Diagnosis → Fix → Result format every time.</p>
      </div>

      <div class="cases-list">
<% caseStudies.forEach(function(c) { %>
        <div class="case-card">
          <div class="case-head">
            <span class="case-tag"><i class="<%= c.tag_icon %>"></i> <%= c.tag %></span>
            <div class="case-tools">
<% c.tools.forEach(function(tool) { %>
              <span><%= tool %></span>
<% }); %>
            </div>
          </div>
          <h3><%= c.title %></h3>
          <div class="case-flow">
            <div class="case-step cs-problem">
              <span class="cs-label">Problem</span>
              <p><%- c.problem %></p>
            </div>
            <div class="case-step cs-diagnosis">
              <span class="cs-label">Diagnosis</span>
              <p><%- c.diagnosis %></p>
            </div>
            <div class="case-step cs-fix">
              <span class="cs-label">Fix</span>
              <p><%- c.fix %></p>
            </div>
            <div class="case-step cs-result">
              <span class="cs-label">Result</span>
              <p><%- c.result %></p>
            </div>
          </div>
        </div>
<% }); %>
      </div>
<% if (caseStudies.some(function(c) { return c.is_placeholder; })) { %>
      <p class="cases-note"><i class="fa-solid fa-circle-info"></i> Figures shown are representative placeholders — swap in your real client numbers before launch.</p>
<% } %>
    </div>
  </section>

  <!-- ===== WHAT EVERY ENGAGEMENT INCLUDES ===== -->
  <section class="section bg-soft">
    <div class="container">
      <div class="section-head">
        <span class="badge">Consistent Every Time</span>
        <h2>What You Get on <span class="highlight">Every Project</span></h2>
        <p>The same rigor whether it's a one-page fix or a full rebuild.</p>
      </div>
      <div class="values-grid">
        <div class="value-card">
          <div class="vc-icon" style="--vc:#1d3557"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
          <h3>A Real Diagnosis</h3>
          <p>I find the actual root cause — event dedup, EMQ, missing GCLID — not a surface-level guess.</p>
        </div>
        <div class="value-card">
          <div class="vc-icon" style="--vc:#2d5f8a"><i class="fa-solid fa-vial-circle-check"></i></div>
          <h3>Verified, Not Assumed</h3>
          <p>Every fix is validated in DebugView and Tag Assistant with real test transactions before it's called done.</p>
        </div>
        <div class="value-card">
          <div class="vc-icon" style="--vc:#e9c46a"><i class="fa-solid fa-chart-line"></i></div>
          <h3>Measurable Results</h3>
          <p>Outcomes tied to numbers you can check — accuracy, match quality, attribution, cost per lead.</p>
        </div>
        <div class="value-card">
          <div class="vc-icon" style="--vc:#10b981"><i class="fa-solid fa-key"></i></div>
          <h3>Full Ownership</h3>
          <p>Every account, container, and line of code is yours, with documentation handed over at the end.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MINI CTA ===== -->
  <section class="section mini-cta">
    <div class="container">
      <span class="badge"><i class="fa-solid fa-comments"></i> Your Turn</span>
      <h2>Want a Result Like These?</h2>
      <p>Tell me what's broken or what you're building. I'll reply with a straight assessment of what it'll take — no obligation.</p>
      <a href="/contact.html" class="btn btn-primary">Book a Call <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </section>

<%- include('partials/footer') %>
<%- include('partials/whatsapp-float', { waText }) %>
</body>
</html>
