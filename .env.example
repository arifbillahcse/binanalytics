# Copy to .env and fill in real values. Never commit .env.

PORT=3000

# cPanel MySQL: Databases panel gives you the full prefixed names,
# e.g. DB_NAME=cpaneluser_binanalytics, DB_USER=cpaneluser_binadmin
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Contact form notification email (Nodemailer). On cPanel, create an email
# account under Email Accounts and use its SMTP details here — leave these
# blank to disable email notifications (submissions still save to the DB).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_EMAIL_TO=

